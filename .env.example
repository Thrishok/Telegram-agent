# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# Groq API Key (for LLM and Vision models)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (for Web Search tool)
TAVILY_API_KEY=your_tavily_api_key_here

# Port for FastAPI server (default: 8000)
PORT=8000

# Neon PostgreSQL Connection Strings
# DATABASE_URL: Pooled connection (used at runtime with PgBouncer)
DATABASE_URL=postgresql://user:password@pooler.host.neon.tech/dbname?sslmode=require
# DATABASE_URL_DIRECT: Direct connection (used for setup/migrations, no PgBouncer)
DATABASE_URL_DIRECT=postgresql://user:password@ep-xxx-user-connectionpoint.aws.neon.tech/dbname?sslmode=require

# LangMem & Memory Configuration
# Embedding model for semantic search (must match vector dims)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMS=384
# Short-term window: number of recent messages to include
SHORT_TERM_WINDOW=10
# Memory top-k: number of memories to retrieve per turn
MEMORY_TOP_K=5
# Episode TTL in days
EPISODE_TTL_DAYS=90
# Enable/disable background memory extraction
ENABLE_MEMORY_EXTRACTION=true
# Model for memory extraction (cheaper is better)
MEMORY_EXTRACTION_MODEL=openai/gpt-oss-120b

# LangSmith tracing (optional)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_PROJECT=telegram-agent